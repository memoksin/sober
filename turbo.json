{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	// The fake host in test/integration reads these; naming them here keeps
	// caching correct and the lint rule quiet.
	"globalPassThroughEnv": [
		"FAKE_HOST_FAIL",
		"FAKE_HOST_HANG",
		"FAKE_HOST_LOGGED_OUT",
		"FAKE_HOST_WRITE"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		}
	}
}
