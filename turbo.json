{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	// The fake host in test/integration reads these; naming them here keeps
	// caching correct and the lint rule quiet.
	"globalPassThroughEnv": [
		"FAKE_GH_CHECKS",
		"FAKE_GH_FAIL",
		"FAKE_GH_STATE",
		"FAKE_HOST_COMMIT",
		"FAKE_HOST_FAIL",
		"FAKE_HOST_HANG",
		"FAKE_HOST_LOGGED_OUT",
		"FAKE_HOST_WRITE",
		"SOBER_GH"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			// `tsc -b` writes its incremental state here and emits nothing when it
			// says the build is current. Restoring `dist` without it leaves the two
			// disagreeing, and the next build produces no output at all.
			"outputs": ["dist/**", "*.tsbuildinfo"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		}
	}
}
