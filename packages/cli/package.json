{
	"name": "@besober/cli",
	"version": "0.1.1",
	"description": "SOBER \u2014 agentic development platform.",
	"type": "module",
	"bin": {
		"sober": "./dist/sober.js"
	},
	"files": [
		"dist",
		"!dist/**/*.map"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node build.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"publint": "publint --strict"
	},
	"devDependencies": {
		"@besober/core": "workspace:*",
		"@besober/dashboard": "workspace:*",
		"@besober/mcp": "workspace:*",
		"@besober/schema": "workspace:*",
		"@besober/server": "workspace:*",
		"esbuild": "^0.28.0",
		"publint": "^0.3.16"
	},
	"dependencies": {
		"secretlint": "^13.0.5",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.5"
	}
}
