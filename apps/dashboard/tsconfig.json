{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../../packages/tsconfig/base.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"noEmit": true,
		"jsx": "react-jsx",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client"]
	},
	"include": ["src/**/*"]
}
