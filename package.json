{
	"name": "sober",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"typecheck": "turbo run build && tsc --noEmit -p tsconfig.json && turbo run typecheck",
		"test": "turbo run build && vitest run",
		"integration": "turbo run build && vitest run --project integration",
		"lint": "biome check . && secretlint --secretlintignore .gitignore \"**/*\"",
		"format": "biome check --write .",
		"boundaries": "depcruise packages test --config .dependency-cruiser.cjs",
		"scan": "secretlint --secretlintignore .gitignore \"**/*\"",
		"demo:dispatch": "pnpm --filter @besober/core build && node scripts/demo-dispatch.mjs",
		"demo:scan": "pnpm --filter @besober/core build && node scripts/demo-scan.mjs",
		"demo:cli": "pnpm --filter @besober/cli build && node scripts/demo-cli.mjs",
		"coverage": "turbo run build && vitest run --coverage",
		"coverage:check": "node scripts/coverage-ratchet.mjs",
		"coverage:update": "vitest run --coverage && node scripts/coverage-ratchet.mjs --update",
		"demo:mcp": "pnpm --filter @besober/cli build && node scripts/demo-mcp.mjs",
		"release": "pnpm publish --recursive --access public --no-git-checks",
		"demo:plugin": "pnpm --filter @besober/cli build && node scripts/demo-plugin.mjs",
		"gate:m1": "pnpm --filter @besober/cli build && node scripts/m1-gate.mjs",
		"demo:sync": "pnpm --filter @besober/cli build && node scripts/demo-sync.mjs",
		"demo:conflict": "pnpm --filter @besober/cli build && node scripts/demo-conflict.mjs",
		"demo:team": "pnpm --filter @besober/cli build && node scripts/demo-team.mjs",
		"demo:pr": "pnpm --filter @besober/cli build && node scripts/demo-pr.mjs",
		"gate:m2": "pnpm --filter @besober/cli build && node scripts/m2-gate.mjs"
	},
	"devDependencies": {
		"@besober/core": "workspace:*",
		"@besober/mcp": "workspace:*",
		"@biomejs/biome": "^2.4.2",
		"@changesets/cli": "^3.0.1",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
		"@types/node": "^26.4.0",
		"@vitest/coverage-v8": "^4.1.3",
		"dependency-cruiser": "^18.2.0",
		"secretlint": "^13.0.5",
		"turbo": "^2.10.12",
		"typescript": "^6.0.3",
		"vitest": "^4.1.3"
	},
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=22"
	}
}
