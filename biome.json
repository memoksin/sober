{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "ignoreUnknown": false },
	"formatter": { "enabled": true, "indentStyle": "tab", "lineWidth": 100 },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": { "noExplicitAny": "error" },
			"style": {
				"useNodejsImportProtocol": "error",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"node:path/posix": "Use node:path — POSIX-only path handling breaks the Windows integration job.",
							"path/posix": "Use node:path — POSIX-only path handling breaks the Windows integration job."
						}
					}
				}
			}
		}
	},
	"css": { "parser": { "tailwindDirectives": true } },
	"javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
	"assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
